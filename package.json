{
  "name": "archive-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "lint": "bun run lint:format && bun run lint:shell && bun run lint:eslint && bun run lint:types",
    "lint:format": "prettier --check .",
    "lint:eslint": "eslint .",
    "lint:shell": "find .githooks scripts -type f -exec sh -n {} +",
    "lint:types": "tsc --noEmit --project tsconfig.lint.json",
    "prepare": "./scripts/setup-hooks.sh",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "astro": "^7.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0"
  }
}
