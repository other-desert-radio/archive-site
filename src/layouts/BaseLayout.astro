---
import { ClientRouter } from "astro:transitions";

type Props = {
  title: string;
  page: "archive" | "dj_page";
  returning_page: "archive" | "home";
};

const {
  title = "Archive Site",
  page = "archive",
  returning_page = "home",
} = Astro.props;
import "../styles/global.css";
import "../styles/styles.css";
import Navigation from "../components/Navigation.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body transition:animate="none">
    <Navigation page={page} returning_page={returning_page} />
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  main {
    padding-inline: 6rem;
  }
</style>
