---
import { ClientRouter } from "astro:transitions";

type Props = {
  title: string;
  page: "shows" | "djs" | "dj_page" | "show_page";
  returning_page: "shows" | "djs" | "home";
};

const {
  title = "Archive Site",
  page = "shows",
  returning_page = "home",
} = Astro.props;
import "../styles/global.css";
import "../styles/styles.css";
import Navigation from "../components/Navigation.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body transition:animate="none">
    <Navigation page={page} returning_page={returning_page} />
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  main {
    width: 100%;
    max-width: 120rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  @media (min-width: 750px) {
    main {
      padding-inline: 4rem;
    }
  }
</style>
