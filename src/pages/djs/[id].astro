---
import { pathToFileURL } from "node:url";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagView from "../../components/TagView.astro";
import { fetchDJ, type HydratedDJ } from "../../utils/fetch-dj";
import { fetchDJs } from "../../utils/fetch-djs";
import { fetchTags } from "../../utils/fetch-tags";

type Props = {
  dj: HydratedDJ;
};

/** Generates static DJ detail pages from the archive summary during Astro builds. */
export async function getStaticPaths() {
  const djs = await fetchDJs(pathToFileURL("public/archive/djs_brief.json"));

  return Promise.all(
    djs.map(async ({ id }) => ({
      params: { id: String(id) },
      props: {
        dj: await fetchDJ(pathToFileURL(`public/archive/djs/${id}.json`)),
      },
    })),
  );
}

const { dj } = Astro.props as Props;
const tags = await fetchTags(pathToFileURL("public/archive/tags.json"));
---

<BaseLayout
  page="dj_page"
  returning_page="djs"
  title={`${dj.title} | Other Desert Radio`}
>
  <h1>{dj.title}</h1>
  <div class="tag-container">
    {
      dj.tagIds.map((id) => {
        const tag = tags.get(id);

        if (tag === undefined) {
          console.error(`Tag ${id} referenced by DJ ${dj.id} does not exist.`);
          return undefined;
        }

        return <TagView tag={tag} />;
      })
    }
  </div>
  <div set:html={dj.socials} />
  <div set:html={dj.bio} />
  <p>{dj.showTitle}</p>
  <p>{dj.showDescription}</p>
</BaseLayout>
