---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fetchDJs, type DJ } from "../../utils/fetch-djs";

type Props = {
	dj: DJ;
};

/** Generates static DJ detail pages from the archive summary during Astro builds. */
export async function getStaticPaths() {
	const djs = await fetchDJs();

	return djs.map((dj) => ({
    params: { id: String(dj.id) },
    props: { dj },
  }));
}

const { dj } = Astro.props as Props;
---

<BaseLayout
  page="dj_page"
  returning_page="djs"
  title={`${dj.title} | Other Desert Radio`}
>
  <h1>{dj.title}</h1>
  <p>DJ details coming soon.</p>
</BaseLayout>
