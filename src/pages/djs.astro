---
import { pathToFileURL } from "node:url";
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryTabs from "../components/CategoryTabs.astro";
import DJsPane from "../components/dj/DJsPane.tsx";
import { fetchDJs } from "../utils/fetch-djs";
import { fetchTags } from "../utils/fetch-tags";

const tags = await fetchTags(pathToFileURL("public/archive/tags.json"));
const djs = await fetchDJs(pathToFileURL("public/archive/djs_brief.json"));
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="DJs | Other Desert Radio"
  page="archive"
  returning_page="home"
>
  <CategoryTabs active="djs" />
  <DJsPane base={base} djs={djs} tags={tags} />
</BaseLayout>
