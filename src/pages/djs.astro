---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryTabs from "../components/CategoryTabs.astro";
import DJsPane from "../components/DJsPane.tsx";
import { fetchDJs } from "../utils/fetch-djs";

const djs = await fetchDJs();
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="DJs | Other Desert Radio"
  page="archive"
  returning_page="home"
>
  <CategoryTabs active="djs" />
  <DJsPane base={base} djs={djs} />
</BaseLayout>
