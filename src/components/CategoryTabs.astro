---
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
type Props = {
  active: "shows" | "djs";
};

const { active } = Astro.props;
---

<div class="tabs">
  <a href={base} aria-current={active === "shows" ? "page" : undefined}>SHOWS</a
  >
  <a href={`${base}djs`} aria-current={active === "djs" ? "page" : undefined}
    >DJs</a
  >
</div>

<style>
  .tabs {
    display: flex;
  }
  a {
    text-decoration: none;
  }

  a[aria-current="page"] {
    font-weight: bold;
    border-bottom: 2px solid; /* TODO: maybe set the border all the time */
  }
</style>
