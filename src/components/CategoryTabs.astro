---
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
type Props = {
  active: "shows" | "djs";
};

const { active } = Astro.props;
---

<div class="tabs">
  <a href={base} aria-current={active === "shows" ? "page" : undefined}>SHOWS</a
  >
  <a href={`${base}djs`} aria-current={active === "djs" ? "page" : undefined}
    >DJs</a
  >
</div>

<style>
  .tabs {
    display: flex;
    gap: 1rem;
    margin-top: 3rem;
  }

  a {
    text-decoration: none;
    color: black;
    font-size: 1.5rem;
  }

  a:hover {
    border-bottom: 3px solid;
  }

  a[aria-current="page"] {
    font-weight: bold;
    border-bottom: 6px solid;
  }
</style>
