---
type Props = {
  page: "archive" | "dj_page";
  returning_page: "archive" | "home";
};

const { page, returning_page } = Astro.props;
---

<nav aria-label="Navigation title">
  <a
    class="leading-box"
    title={`Return to ${returning_page}`}
    href={returning_page === "archive"
      ? `${import.meta.env.BASE_URL}archive`
      : "https://otherdesertradio.com"}
  >
    <img
      class="back-arrow"
      src={`${import.meta.env.BASE_URL}back-arrow.svg`}
      alt="←"
    />
    <b>{returning_page.toUpperCase()}</b>
  </a>

  <span>OTHER DESERT RADIO / {page.toUpperCase()}</span>
</nav>

<style>
  nav {
    display: flex;
    padding: 25px 50px;
    align-items: center;
    gap: 25px;

    font-size: 0.875rem;

    background: black;
    color: white;
  }

  .leading-box {
    display: flex;
    flex-direction: row;
    gap: 5px;
    color: inherit;
    text-decoration: none;
  }

  .leading-box:hover {
    font-weight: bold;
    text-decoration: underline;
  }

  .back-arrow {
    width: 15px;
  }
</style>
