---
type Props = {
  page: "shows" | "djs" | "dj_page" | "show_page";
  returning_page: "shows" | "djs" | "home";
};

const { page, returning_page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const returnHref =
  returning_page === "home"
    ? "https://otherdesertradio.com"
    : returning_page === "djs"
      ? `${base}/djs`
      : `${base}/`; // TODO: collapse this
---

<nav aria-label="Navigation title">
  <a
    class="leading-box"
    title={`Return to ${returning_page}`}
    href={returnHref}
  >
    <span aria-hidden="true">←</span>
    <b>{returning_page.toUpperCase()}</b>
  </a>

  <span>OTHER DESERT RADIO / {page.toUpperCase()}</span>
</nav>

<style>
  nav {
    display: grid;
    grid-template-columns: 75px auto;
    padding: 25px 50px;
    align-items: center;

    font-size: 0.875rem;

    background: black;
    color: white;
  }

  .leading-box {
    display: flex;
    flex-direction: row;
    gap: 5px;
    color: inherit;
    text-decoration: none;
  }

  .leading-box:hover {
    font-weight: bold;
    text-decoration: underline;
  }
</style>
